# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ADMIN_TOKEN: Secret that protects all admin/CRM API endpoints
# (reading/updating/deleting leads, uploads, Google Sheets config & sync).
# This value IS the admin login password. Set it as a Cloudflare Pages secret,
# never commit the real value:
#   npx wrangler pages secret put ADMIN_TOKEN
ADMIN_TOKEN="CHANGE_ME_TO_A_LONG_RANDOM_SECRET"

# STAFF_TOKEN (optional): Staff login password with LIMITED rights — manage
# articles & products (add/edit/delete), upload content images, view leads and
# update their status. Staff CANNOT delete leads, change Google Sheets config,
# or open Admin Settings. Leave unset to disable staff login.
#   npx wrangler pages secret put STAFF_TOKEN
STAFF_TOKEN="CHANGE_ME_TO_A_DIFFERENT_LONG_RANDOM_SECRET"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
